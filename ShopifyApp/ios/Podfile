# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ShopifyApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix react-native-tts BOOL * bridge crash on iOS 26
    tts_file = File.join(__dir__, '../node_modules/react-native-tts/ios/TextToSpeech/TextToSpeech.m')
    if File.exist?(tts_file)
      content = File.read(tts_file)
      patched = content
        .gsub('stop:(BOOL *)onWordBoundary', 'stop:(NSNumber *)onWordBoundary')
        .gsub('pause:(BOOL *)onWordBoundary', 'pause:(NSNumber *)onWordBoundary')
        .gsub('if(onWordBoundary != NULL && onWordBoundary)', 'if(onWordBoundary != nil && [onWordBoundary boolValue])')
        .gsub('setDucking:(BOOL *)ducking', 'setDucking:(NSNumber *)ducking')
        .gsub('_ducking = ducking;', '_ducking = [ducking boolValue];')
        .gsub('if(ducking)', 'if([ducking boolValue])')
        .gsub('skipTransform:(BOOL *)skipTransform', 'skipTransform:(NSNumber *)skipTransform')
      File.write(tts_file, patched) unless content == patched
    end
  end
end
